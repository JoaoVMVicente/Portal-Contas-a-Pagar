# ===========================================================================
# Copie este arquivo para ".env" e preencha. O arquivo .env nunca vai para o
# GitHub (ele esta no .gitignore).
# ===========================================================================

# Porta em que o back-end escuta na sua maquina.
PORT=3333

# Enderecos que podem chamar este back-end, separados por virgula.
# Em producao, troque pelo endereco do seu GitHub Pages.
ORIGENS_PERMITIDAS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500

# ---------------------------------------------------------------------------
# Supabase. Pegue em: Project Settings > API
# ---------------------------------------------------------------------------
# Endereco do projeto (ex.: https://abcdefgh.supabase.co)
SUPABASE_URL=

# Chave publica ("anon"). Pode aparecer no navegador sem problema.
SUPABASE_ANON_KEY=

# Chave secreta ("service_role"). NUNCA coloque isso no front-end.
# So o back-end pode conhecer esta chave. Ela ignora o RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Tamanho maximo de arquivo aceito, em megabytes.
TAMANHO_MAX_ARQUIVO_MB=10

# Dominios de e-mail que podem usar o portal, separados por virgula.
DOMINIOS_PERMITIDOS=srna.co

# ---------------------------------------------------------------------------
# Endereco do portal. E para ca que o link do e-mail leva a pessoa.
# Local:     http://localhost:8080
# Publicado: https://SEU-USUARIO.github.io/portal-boletos-serena
# ---------------------------------------------------------------------------
ENDERECO_DO_PORTAL=http://localhost:8080
